from flask import Flask, request, jsonify
from flask_cors import CORS
import requests

app = Flask(__name__)
CORS(app)

@app.route('/check', methods=['POST'])
def check_video():
    data = request.get_json()
    video_url = data.get('url', '').strip()

    if not video_url:
        return jsonify({'error': 'يرجى إدخال رابط الفيديو'}), 400

    url = "https://tiktok-best-experience.p.rapidapi.com/url"
    
    headers = {
        "x-rapidapi-key": "27adeeadc1msh0748356d52e5a19p1d340bjsn119da783b0e6",
        "x-rapidapi-host": "tiktok-best-experience.p.rapidapi.com"
    }

    try:
        response = requests.get(url, headers=headers, params={"url": video_url}, timeout=15)
        res = response.json()
        data_res = res.get("data") or res

        if "author" in data_res or "aweme_detail" in data_res:
            detail = data_res.get("aweme_detail") or data_res
            author = detail.get("author", {})
            
            username = author.get("unique_id") or author.get("nickname") or "غير معروف"
            nickname = author.get("nickname", "")
            
            return jsonify({
                'original_user': f"@{username} ({nickname})",
                'video_status': '✅ تم استخراج صاحب الفيديو بنجاح!',
                'original_url': video_url
            })
        else:
            return jsonify({
                'original_user': '@غير معروف',
                'video_status': '⚠️ تأكد من تفعيل الخدمة من موقع RapidAPI',
                'original_url': video_url
            })

    except Exception as e:
        return jsonify({
            'original_user': '@خطأ',
            'video_status': '❌ حدث خطأ في الاتصال بالخادم',
            'original_url': video_url
        })

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000)